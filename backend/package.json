{
  "name": "veriagent-pay-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS backend for VeriAgent Pay, supporting cross-platform bots & socialAA integration via Veridex SDK",
  "scripts": {
    "dev": "nest build && nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest build && nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "db:clear": "bun run scripts/clear-db.ts",
    "passkeys:migrate:dry-run": "bun run scripts/migrate-legacy-passkeys.production.js",
    "passkeys:migrate": "bun run scripts/migrate-legacy-passkeys.production.js --apply",
    "session-keys:migrate-v2": "bun run scripts/migrate-session-keys-v2.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.700.0",
    "@google/generative-ai": "0.21.0",
    "@levischuck/tiny-cbor": "^0.2.11",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/throttler": "5.1.2",
    "@nestjs/websockets": "10.4.22",
    "@prisma/client": "5.22.0",
    "@simplewebauthn/server": "^13.2.2",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/qrcode": "1.5.6",
    "@veriagent/chain-solana": "workspace:*",
    "@veridex/agent-security": "0.1.4",
    "@veridex/agentic-payments": "2.0.7",
    "@veridex/agents": "0.1.7",
    "@willsoto/nestjs-prometheus": "6.0.0",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "crypto-js": "4.2.0",
    "dotenv": "^16.4.5",
    "ethers": "6.16.0",
    "express": "4.22.1",
    "google-auth-library": "^11.0.1",
    "helmet": "7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.2",
    "nanoid": "3.3.18",
    "prom-client": "15.1.0",
    "qrcode": "1.5.4",
    "socket.io": "4.8.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "10.4.22",
    "@types/express": "5.0.6",
    "@types/minimatch": "5.1.2",
    "@types/node": "^20.11.5",
    "prisma": "5.22.0",
    "typescript": "^5.3.3"
  }
}
