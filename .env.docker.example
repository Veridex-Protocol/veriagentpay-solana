# Copy this file to .env.docker and generate every blank secret independently.
# Docker Compose reads it with: docker compose --env-file .env.docker ...

BACKEND_NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=4000

POSTGRES_DB=veriagent_solana
POSTGRES_USER=veriagent
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://veriagent:CHANGE_ME@db:5432/veriagent_solana?schema=public

REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# Generate each value separately with: openssl rand -hex 32
JWT_SECRET=
ADMIN_JWT_SECRET=
DEEPLINK_SECRET=
INTERACTIVE_ACTION_SECRET=
SESSION_KEY_MASTER_SECRET=
NEXTAUTH_SECRET=
CREDENTIAL_KEK_CURRENT=1
CREDENTIAL_KEK_V1=

# Required by the copied admin module even when admin login is not configured.
GOOGLE_OAUTH_CLIENT_ID=disabled-admin.apps.googleusercontent.com

# Temporary compatibility key for dormant inherited EVM services. Generate with:
# printf '0x%s\n' "$(openssl rand -hex 32)"
# It is not the Solana fee payer and must never hold funds.
RELAYER_PRIVATE_KEY=

PUBLIC_APP_URL=https://veriagentpay.xyz
RP_ID=veriagentpay.xyz
WEBAUTHN_ORIGIN=https://veriagentpay.xyz
ALLOWED_ORIGINS=https://veriagentpay.xyz,https://www.veriagentpay.xyz,https://app.veriagentpay.xyz

SOLANA_CLUSTER=devnet
SOLANA_CLUSTER_DOMAIN=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
SOLANA_COMMITMENT=confirmed
SOLANA_EXPLORER_URL=https://explorer.solana.com
SOLANA_PROGRAM_ID=AJirAN6RarZXyHWfYLSFB6NUCbFG3RaKDXMCDueRi7uV
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Use a dedicated funded runtime fee payer. Do not use the program upgrade key
# in production. The file is mounted as /run/secrets/solana_fee_payer.
SOLANA_FEE_PAYER_KEYPAIR_FILE=.keys/devnet-fee-payer.json
RELAYER_MIN_BALANCE_LAMPORTS=50000000

ENABLED_PLATFORMS=
TELEGRAM_BOT_USERNAME=VeriAgentPayBot
GEMINI_API_KEY=