{
  "name": "veriagent-pay-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform Next.js 14 frontend / Mini App for VeriAgent Pay",
  "scripts": {
    "clean": "rm -rf .next .next-dev",
    "clean:build": "rm -rf .next",
    "dev": "node ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:clean": "bun run clean && bun run dev",
    "prebuild": "bun run clean:build",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^9.0.1",
    "@tanstack/react-query": "^5.17.19",
    "@telegram-apps/sdk": "^1.0.0",
    "@veridex/sdk": "^1.1.6",
    "@veriagent/chain-solana": "workspace:*",
    "canvas-confetti": "^1.9.2",
    "clsx": "^2.1.0",
    "ethers": "6.16.0",
    "framer-motion": "^11.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "next": "15.5.23",
    "next-auth": "^4.24.15",
    "qrcode.react": "3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.2.1",
    "viem": "^2.7.9",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.17",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "resolutions": {
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18"
  },
  "overrides": {
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18"
  }
}
